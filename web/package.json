{
  "name": "gt-calib-dataset-review",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare-hosted review site for the GT_calib glove and MOCAP dataset.",
  "scripts": {
    "build": "python3 build_site.py",
    "dev": "wrangler dev --local --port 8810",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
