{
  "model": {
    "visual_mode": "cached",
    "rgb_feature_dim": 256,
    "use_depth": false,
    "hidden": 32,
    "slow_hidden": 16,
    "use_slow": true,
    "use_dynamics": true,
    "learned_noise": true
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "training": {
    "seed": 42,
    "epochs": 1,
    "max_steps": 2,
    "chunk_length": 8,
    "rollout_steps": 2,
    "grad_clip": 1.0,
    "cpu_threads": 2,
    "checkpoint_every": 1,
    "log_every": 1,
    "nll_warmup_steps": 500
  },
  "losses": {
    "joints": 1.0,
    "root": 1.0,
    "markers": 1.0,
    "rotation": 0.1,
    "velocity": 0.02,
    "reprojection": 0.01,
    "observation": 0.01,
    "calibration": 0.001,
    "nll": 0.0,
    "rollout": 0.2
  }
}
