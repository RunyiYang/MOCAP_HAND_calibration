{
  "model": {
    "visual_mode": "cached",
    "rgb_feature_dim": 256,
    "use_depth": false,
    "hidden": 256,
    "slow_hidden": 64,
    "use_slow": false,
    "use_dynamics": false,
    "learned_noise": false
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "training": {
    "seed": 42,
    "epochs": 20,
    "max_steps": 1000,
    "chunk_length": 64,
    "rollout_steps": 0,
    "grad_clip": 1.0,
    "cpu_threads": 2,
    "checkpoint_every": 100,
    "log_every": 10,
    "nll_warmup_steps": 500
  },
  "losses": {
    "joints": 1.0,
    "root": 1.0,
    "markers": 1.0,
    "rotation": 0.1,
    "velocity": 0.02,
    "reprojection": 0.01,
    "observation": 0.01,
    "calibration": 0.001,
    "nll": 0.0,
    "rollout": 0.0
  }
}
